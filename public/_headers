# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
# Rules are matched top to bottom and their headers merged, so the security
# set below applies to every path and the cache rules add to it.

# Security headers on everything, plus a permissions policy.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()

# Hashed build assets never change: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The resume PDF and the pages that link it: always revalidate, so a new
# resume is seen on the next load. Note: the zone's Browser Cache TTL
# (Cloudflare dashboard) rewrites Cache-Control on cacheable file types
# such as .pdf to its own value unless set to "Respect Existing Headers".
/Ritwick_Verma_Resume.pdf
  Cache-Control: no-cache, must-revalidate
/resume/
  Cache-Control: no-cache, must-revalidate
/
  Cache-Control: no-cache, must-revalidate
